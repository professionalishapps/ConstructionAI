{
  "name": "construction-ai",
  "version": "1.0.0",
  "description": "Construction Project Risk Monitor & Budget Protection System",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=frontend",
    "install:frontend": "npm install --workspace=frontend",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "cd backend && pytest",
    "lint:frontend": "npm run lint --workspace=frontend",
    "docker:up": "cd infrastructure/docker && docker-compose up -d",
    "docker:down": "cd infrastructure/docker && docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/construction-ai.git"
  },
  "keywords": [
    "construction",
    "risk-monitoring",
    "ai",
    "project-management"
  ],
  "author": "Your Name",
  "license": "MIT"
}
